<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>mac</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>com/techsenger/ceffx/natives/*.properties</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../../native/build/Release/mac</directory>
            <outputDirectory>native/libs</outputDirectory>
            <includes>
                <include>libceffx.dylib</include>
                <include>ceffx Helper.app/**</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${project.build.outputDirectory}/com/techsenger/ceffx/natives/native-mac.properties</source>
            <outputDirectory>com/techsenger/ceffx/natives</outputDirectory>
            <destName>native.properties</destName>
        </file>
    </files>
</assembly>
