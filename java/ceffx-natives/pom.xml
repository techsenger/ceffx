<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.techsenger.ceffx</groupId>
        <artifactId>ceffx</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <groupId>com.techsenger.ceffx</groupId>
    <artifactId>ceffx-natives</artifactId>
    <packaging>jar</packaging>
    <name>CEFFX - Natives</name>
    <description>Native libraries module</description>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.2.1</version>
                <executions>
                    <execution>
                        <id>read-cef-version</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${basedir}/../../cef.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <!--
                            Moved from the default "package" phase to "verify". By default this execution runs in the
                            same "package" phase as attach-javadocs (maven-javadoc-plugin), and on JDK 25 packaging
                            module-info.class here triggers maven-jar-plugin to invoke the external "jar" tool to
                            finalize a modular JAR - which then causes the subsequent attach-javadocs execution to fail
                            with "No source files for package" even though the source files are present. Moving this
                            execution to "verify" (right after "package") avoids that interaction: javadoc now
                            always runs first. Since this JAR intentionally contains no code nothing else in the build
                            depends on it being ready during "package".
                        -->
                        <phase>verify</phase>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <!-- The JAR without a classifier contains no code -->
                        <include>__nothing__/**</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
        Each profile below activates by default only for its matching OS, so a local "mvn install" on a single machine
        builds only that machine's classifier jar, without requiring the other platforms' native binaries to be present.
        In CI, all four are force-activated together in a single invocation via "-P linux,mac,mac-aarch64,windows"
        (activation conditions are ignored when a profile is requested explicitly), so all four classifier jars are
        produced and deployed with one shared snapshot timestamp.

        Each profile references its own fixed native-<classifier>.xml assembly descriptor (id and source directory
        hardcoded), rather than a single shared descriptor driven by a natives.classifier property. Maven properties are
        resolved once per build session, not per profile/execution - when multiple profiles are active together (as in
        CI above), a property with the same key declared in each profile collapses to a single value for the whole
        build, not a different value per execution. A shared property-driven descriptor would make all four assembly
        executions resolve to the same classifier instead of four different ones, so the per-classifier values must be
        hardcoded in separate descriptor files instead.
    -->
    <profiles>
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-linux</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/native-linux.xml</descriptor>
                                    </descriptors>
                                    <finalName>${project.artifactId}-${project.version}</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mac</id>
            <activation>
                <os>
                    <name>Mac OS X</name>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-mac</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/native-mac.xml</descriptor>
                                    </descriptors>
                                    <finalName>${project.artifactId}-${project.version}</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <activation>
                <os>
                    <name>Mac OS X</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-mac-aarch64</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/native-mac-aarch64.xml</descriptor>
                                    </descriptors>
                                    <finalName>${project.artifactId}-${project.version}</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-win</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/native-win.xml</descriptor>
                                    </descriptors>
                                    <finalName>${project.artifactId}-${project.version}</finalName>
                                    <appendAssemblyId>true</appendAssemblyId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>